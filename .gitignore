production/app/backend/data/*.jsonl
workflows/rentabilidad-evaluation/historial_evaluaciones.jsonl

# Propuestas Urbannit generadas automaticamente por contacto real (D-057) -- llevan
# el nombre real del prospecto, PII, nunca al repo. Mismo criterio que contactos.jsonl.
production/app/backend/data/urbannit_docs_generados/
__pycache__/
*.pyc
node_modules/

# Outputs regenerables del pipeline de generadores/ -- la copia final versionada
# vive en production/entregables/, no acá (evita duplicar binarios grandes en git).
production/generadores/*.pptx
production/generadores/*.pdf
production/generadores/*.docx
production/generadores/Meridiano_WhatsApp_Frio.png

# Renders de página de trabajo usados para leer PDFs escaneados en un caso de
# contracts/ (OCR visual) -- derivados, regenerables desde source-documents/,
# no un entregable. Mismo criterio que la regla de generadores/ de arriba.
contracts/cases/*/extracted-data/page-renders/

# Transcripciones literales de boletos de compraventa (u otro instrumento legal
# con PII completa de las partes -- domicilio, email, telefono, RUC personal).
# Ver governance/PII_POLICY.md y D-093 (limpieza historica de UON-001,
# 2026-08-29): la fuente legal completa no se versiona, solo los hechos ya
# extraidos y verificados en facts/FACT_REGISTER.md. Patron acotado a
# "boleto_<UNA LETRA>.txt" (boleto_A, boleto_B, ...) para no capturar de mas --
# no afecta a boleto_diff.txt (comparacion de versiones, sin PII, ya trackeado).
contracts/cases/*/extracted-data/boleto_[A-Z].txt

# Higiene preventiva de secretos (Fase 7, R-B2) -- ninguno de estos existe
# hoy en el repo (verificado), se agrega para que nunca pueda colarse uno
# sin darse cuenta.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json
secrets.yml
secrets.yaml
