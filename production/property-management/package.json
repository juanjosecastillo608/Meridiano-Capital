{
  "name": "meridiano-property-management",
  "version": "0.1.0",
  "private": true,
  "description": "MERIDIANO CAPITAL | PROPERTY MANAGEMENT — sistema de administración inmobiliaria multi-sociedad",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "import:analyze": "tsx scripts/import-analyze.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "decimal.js": "10.4.3",
    "docx": "^9.5.1",
    "exceljs": "4.4.0",
    "jose": "5.9.6",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.0",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
