  "formulas": {
    "monthly_potential": "sum(quantity_i * normalized_monthly_rent_i)",
    "monthly_effective": "sum(quantity_i * normalized_monthly_rent_i * occupancy_i)",
    "annual_gross": "monthly_potential * 12",
    "gross_yield_pct": "annual_gross / purchase_price_same_currency * 100",
    "price_to_annual_rent": "purchase_price_same_currency / annual_gross",
    "noi": "effective_annual_income - owner_operating_expenses",
    "yield_on_total_cost": "noi / (purchase_price + acquisition_costs + capex + leasing_costs)",
    "monthly_gap": "market_rent - current_comparable_rent",
    "percentage_gap": "(market_rent / current_comparable_rent - 1) * 100 only if current rent > 0"
  },
